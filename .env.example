# DeepSeek (server only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_ADVANCED=deepseek-v4-pro
USE_MOCK_LLM=false
# true = Growth Loop targets are sent to the grader and shown to learners; anything else = off
GROWTH_TARGETS=false

# Required for sign-in and saved writing (dedicated FREE project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set true only after configuring Google OAuth in Supabase.
GOOGLE_AUTH_ENABLED=false
# Server-only Supabase pooler URL. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Infra
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Payments / email / observability
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Opt-in, same-origin Web Vitals to structured server logs (10% of page views).
PERFORMANCE_TELEMETRY=false
PERFORMANCE_SAMPLE_RATE=0.1
# Fixed-name auth/database spans to stdout; no query text or parameters.
PERFORMANCE_LOGS=false
# Optional OpenTelemetry collector; configure only for your telemetry destination.
OTEL_EXPORTER_OTLP_ENDPOINT=
