{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["nextjs", "typescript", "react", "import", "jsx-a11y"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "rules": {
    "no-array-constructor": "error",
    "no-unused-expressions": "warn",
    "no-unused-vars": "warn",
    "nextjs/google-font-display": "warn",
    "nextjs/google-font-preconnect": "warn",
    "nextjs/next-script-for-ga": "warn",
    "nextjs/no-async-client-component": "warn",
    "nextjs/no-before-interactive-script-outside-document": "warn",
    "nextjs/no-css-tags": "warn",
    "nextjs/no-head-element": "warn",
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-img-element": "warn",
    "nextjs/no-page-custom-font": "warn",
    "nextjs/no-styled-jsx-in-document": "warn",
    "nextjs/no-sync-scripts": "error",
    "nextjs/no-title-in-document-head": "warn",
    "nextjs/no-typos": "warn",
    "nextjs/no-unwanted-polyfillio": "warn",
    "nextjs/inline-script-id": "error",
    "nextjs/no-assign-module-variable": "error",
    "nextjs/no-document-import-in-page": "error",
    "nextjs/no-duplicate-head": "error",
    "nextjs/no-head-import-in-document": "error",
    "nextjs/no-script-component-in-head": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{js,jsx,mjs,ts,tsx,mts,cts}"],
      "rules": {
        "react/display-name": "error",
        "react/jsx-key": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-target-blank": "off",
        "react/jsx-no-undef": "error",
        "react/no-children-prop": "error",
        "react/no-danger-with-children": "error",
        "react/no-direct-mutation-state": "error",
        "react/no-find-dom-node": "error",
        "react/no-is-mounted": "error",
        "react/no-render-return-value": "error",
        "react/no-string-refs": "error",
        "react/no-unescaped-entities": "error",
        "react/no-unknown-property": "off",
        "react/no-unsafe": "off",
        "react/react-in-jsx-scope": "off",
        "import/no-anonymous-default-export": "warn",
        "jsx-a11y/alt-text": [
          "warn",
          {
            "elements": ["img"],
            "img": ["Image"]
          }
        ],
        "jsx-a11y/aria-props": "warn",
        "jsx-a11y/aria-proptypes": "warn",
        "jsx-a11y/aria-unsupported-elements": "warn",
        "jsx-a11y/role-has-required-aria-props": "warn",
        "jsx-a11y/role-supports-aria-props": "warn",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "warn",
        "react/immutability": "error",
        "react/globals": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/error-boundaries": "error",
        "react/purity": "error",
        "react/set-state-in-render": "error",
        "react/unsupported-syntax": "warn"
      },
      "plugins": ["react", "import", "jsx-a11y"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-var": "error",
        "no-with": "off",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@mui/icons-material",
                "message": "Import icons by path."
              },
              {
                "name": "@emotion/react",
                "message": "Use MUI styling."
              },
              {
                "name": "@emotion/styled",
                "message": "Use MUI styling."
              }
            ],
            "patterns": [
              {
                "group": [
                  "tailwindcss*",
                  "@radix-ui/*",
                  "@headlessui/*",
                  "@chakra-ui/*",
                  "@mantine/*",
                  "antd",
                  "@ant-design/*",
                  "bootstrap",
                  "react-bootstrap",
                  "styled-components",
                  "lucide-react",
                  "react-icons*",
                  "@heroicons/*",
                  "@fortawesome/*",
                  "recharts",
                  "chart.js",
                  "react-chartjs-2",
                  "class-variance-authority",
                  "tailwind-merge",
                  "sonner",
                  "react-hot-toast"
                ],
                "message": "UI must be MUI-only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/db/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@mui/icons-material",
                "message": "Import icons by path."
              },
              {
                "name": "@emotion/react",
                "message": "Use MUI styling."
              },
              {
                "name": "@emotion/styled",
                "message": "Use MUI styling."
              }
            ],
            "patterns": [
              {
                "group": [
                  "tailwindcss*",
                  "@radix-ui/*",
                  "@headlessui/*",
                  "@chakra-ui/*",
                  "@mantine/*",
                  "antd",
                  "@ant-design/*",
                  "bootstrap",
                  "react-bootstrap",
                  "styled-components",
                  "lucide-react",
                  "react-icons*",
                  "@heroicons/*",
                  "@fortawesome/*",
                  "recharts",
                  "chart.js",
                  "react-chartjs-2",
                  "class-variance-authority",
                  "tailwind-merge",
                  "sonner",
                  "react-hot-toast"
                ],
                "message": "UI must be MUI-only."
              },
              {
                "group": ["@/lib/api", "../api", "@/lib/llm/**", "../llm/**", "next/**"],
                "message": "Database operations use domain errors and explicit result contracts, not HTTP or provider adapters."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "project/restricted-syntax": [
          "error",
          {
            "selector": "JSXOpeningElement[name.name=/^[a-z]/]",
            "message": "Use MUI components, not raw UI tags (DESIGN.md §1)."
          },
          {
            "selector": "JSXAttribute[name.name='style']",
            "message": "Use sx or the MUI theme."
          },
          {
            "selector": "JSXAttribute[name.name='className']",
            "message": "Use sx or the MUI theme."
          },
          {
            "selector": "Literal[value=/^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/]",
            "message": "Colors belong in src/theme."
          },
          {
            "selector": "Literal[value=/^(rgb|rgba|hsl|hsla)\\(/]",
            "message": "Use palette tokens."
          },
          {
            "selector": "Literal[value=/\\.Mui[A-Z]/]",
            "message": "MUI internal selectors belong in src/theme."
          }
        ]
      }
    },
    {
      "files": ["src/components/feedback/ConnectorLayer.tsx"],
      "rules": {
        "project/restricted-syntax": [
          "error",
          {
            "selector": "JSXAttribute[name.name='className']",
            "message": "Use sx or the MUI theme."
          },
          {
            "selector": "Literal[value=/^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/]",
            "message": "Colors belong in src/theme."
          },
          {
            "selector": "Literal[value=/^(rgb|rgba|hsl|hsla)\\(/]",
            "message": "Use palette tokens."
          },
          {
            "selector": "Literal[value=/\\.Mui[A-Z]/]",
            "message": "MUI internal selectors belong in src/theme."
          }
        ]
      }
    },
    {
      "files": [
        "src/components/studio/ReadSweep.tsx",
        "src/components/studio/DevelopmentSuggestion.tsx"
      ],
      "rules": {
        "project/restricted-syntax": [
          "error",
          {
            "selector": "JSXOpeningElement[name.name=/^[a-z]/]",
            "message": "Use MUI components, not raw UI tags (DESIGN.md §1)."
          },
          {
            "selector": "JSXAttribute[name.name='className']",
            "message": "Use sx or the MUI theme."
          },
          {
            "selector": "Literal[value=/^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/]",
            "message": "Colors belong in src/theme."
          },
          {
            "selector": "Literal[value=/^(rgb|rgba|hsl|hsla)\\(/]",
            "message": "Use palette tokens."
          },
          {
            "selector": "Literal[value=/\\.Mui[A-Z]/]",
            "message": "MUI internal selectors belong in src/theme."
          }
        ]
      }
    },
    {
      "files": ["src/theme/**"],
      "rules": {
        "project/restricted-syntax": [
          "error",
          {
            "selector": "JSXOpeningElement[name.name=/^[a-z]/]",
            "message": "Use MUI components, not raw UI tags (DESIGN.md §1)."
          },
          {
            "selector": "JSXAttribute[name.name='style']",
            "message": "Use sx or the MUI theme."
          },
          {
            "selector": "JSXAttribute[name.name='className']",
            "message": "Use sx or the MUI theme."
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/icons/**"],
      "rules": {
        "project/restricted-syntax": [
          "error",
          {
            "selector": "JSXAttribute[name.name='style']",
            "message": "Use sx or the MUI theme."
          },
          {
            "selector": "Literal[value=/^(rgb|rgba|hsl|hsla)\\(/]",
            "message": "Use palette tokens."
          },
          {
            "selector": "Literal[value=/\\.Mui[A-Z]/]",
            "message": "MUI internal selectors belong in src/theme."
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/icons/BrandIconImage.tsx"],
      "rules": {
        "project/restricted-syntax": [
          "error",
          {
            "selector": "JSXAttribute[name.name='className']",
            "message": "next/og renders inline styles only."
          },
          {
            "selector": "Literal[value=/^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/]",
            "message": "Colors belong in src/theme."
          }
        ]
      }
    },
    {
      "files": ["src/app/layout.tsx"],
      "rules": {
        "project/restricted-syntax": [
          "error",
          {
            "selector": "JSXAttribute[name.name='style']",
            "message": "Use sx or the MUI theme."
          },
          {
            "selector": "Literal[value=/^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/]",
            "message": "Colors belong in src/theme."
          },
          {
            "selector": "Literal[value=/^(rgb|rgba|hsl|hsla)\\(/]",
            "message": "Use palette tokens."
          },
          {
            "selector": "Literal[value=/\\.Mui[A-Z]/]",
            "message": "MUI internal selectors belong in src/theme."
          }
        ]
      }
    },
    {
      "files": ["src/components/today/Today.tsx", "src/app/today/page.tsx"],
      "rules": {
        "react/purity": "off"
      }
    }
  ],
  "jsPlugins": ["./scripts/oxlint-project-rules.mjs"]
}
